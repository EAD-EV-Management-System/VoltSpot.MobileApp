<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EVChargingStationApp"
        android:usesCleartextTraffic="true">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCAMxkmvnJLJ2wiFXpBeUvCojXlXjPNL98" />

        <!-- Splash Screen (Launcher Activity) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EVChargingStationApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication -->
        <activity android:name=".ui.auth.LoginActivity" android:exported="true" />
        <activity android:name=".ui.auth.RegisterActivity" android:exported="true" />

        <!-- Dashboard (Main Activity after login) -->
        <activity android:name=".ui.dashboard.MainActivity" android:exported="true" />

        <!-- Booking-related Activities -->
        <activity
            android:name=".ui.bookings.AddBookingActivity"
            android:exported="false"
            android:label="Create Booking" />
        <activity
            android:name=".ui.bookings.BookingDetailActivity"
            android:exported="false"
            android:label="Booking Details" />

        <activity
            android:name=".ui.bookings.UpdateBookingActivity"
            android:label="Update Booking"
            android:parentActivityName=".MainActivity" />

        <!-- Station Operator Activities -->
        <activity
            android:name=".ui.operator.OperatorLoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.operator.OperatorBookingDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.operator.QRScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>


</manifest>
